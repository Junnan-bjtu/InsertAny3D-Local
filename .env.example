# InsertAny3D Local configuration template.
# Copy to .env and fill in values for this machine only.
# Never put API keys, SSH private keys, or server cache paths in this file.

# Optional Unity executable used by the real local worker.
UNITY_EXECUTABLE=Unity

# APIYi image-edit endpoint and model. Credentials are loaded separately by
# insertany3d.credentials and should not be committed here.
GEMINI_IMAGE_URL=https://example.invalid/v1beta/models/gemini-image:generateContent
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# SSH connection to the Server checkout. The remote environment is loaded on
# the server from its private runtime.env and is never copied from this file.
INSERTANY3D_REMOTE_TARGET=user@example.invalid
INSERTANY3D_REMOTE_PORT=22
INSERTANY3D_REMOTE_PROJECT_ROOT=/path/to/InsertAny3D-Server
INSERTANY3D_REMOTE_ARTIFACT_ROOT=/path/to/insertany3d-runs
INSERTANY3D_REMOTE_PYTHON=third_party/TRELLIS/.venv/bin/python

# Optional path to a different Local env file, relative to this repository or
# absolute. The loader uses it only when this variable is already exported.
# INSERTANY3D_LOCAL_ENV_FILE=.env
