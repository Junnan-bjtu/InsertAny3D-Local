{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/Junnan-bjtu/InsertAny3D/schemas/heartbeat-v1.schema.json", "title": "InsertAny3D heartbeat v1", "type": "object",
  "required": ["schemaVersion", "kind", "leaseToken", "pid", "pgid", "hostBootId", "processStartTicks", "progress", "logOffset", "observedAtUtc"],
  "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "insertany3d.heartbeat"}, "leaseToken": {"type": "string"}, "pid": {"type": "integer", "minimum": 1}, "pgid": {"type": "integer", "minimum": 1}, "hostBootId": {"type": "string"}, "processStartTicks": {"type": "integer", "minimum": 0}, "progress": {"type": "object", "required": ["completed", "total"], "properties": {"completed": {"type": "number", "minimum": 0}, "total": {"type": "number", "exclusiveMinimum": 0}, "unit": {"type": "string"}, "step": {"type": "string"}}, "additionalProperties": false}, "logOffset": {"type": "integer", "minimum": 0}, "gpu": {"type": ["object", "null"]}, "observedAtUtc": {"type": "string"}}, "additionalProperties": false
}
